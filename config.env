# =============================================================================
# GPU-on-EC2 vLLM 推理服务 —— 部署配置
# 所有变量都可以被同名环境变量覆盖，例如:
#   MODEL_ID=Qwen/Qwen3.5-35B-A3B ./deploy.sh
# =============================================================================

# ---- 基础 ----
PROJECT_NAME="${PROJECT_NAME:-gpu-llm}"            # 资源命名前缀 / Tag Project 值 (小写字母、数字、-)
# 注意: 用 TARGET_REGION 覆盖，而不是 AWS_REGION (避免被 shell 中全局的 AWS_REGION 意外覆盖)
AWS_REGION="${TARGET_REGION:-ap-southeast-5}"      # 马来西亚 (Asia Pacific - Malaysia)

# ---- 网络 ----
VPC_CIDR="${VPC_CIDR:-10.50.0.0/16}"
NAT_MODE="${NAT_MODE:-single}"                     # single = 单 NAT 省成本; per-az = 每 AZ 一个 NAT 高可用
# 允许访问 NLB 推理端口的来源 CIDR (逗号分隔，最多 10 个)。为空时 deploy.sh 会提示输入 (重跑时沿用已部署的值)。
# 强烈不建议使用 0.0.0.0/0: vLLM 的 API Key 只保护 /v1/*，/metrics、/tokenize 等路由不鉴权
# 非交互模式 (--yes) 下使用前缀短于 /8 的 CIDR 需同时设置 ALLOW_PUBLIC_CIDR=1
ALLOWED_CIDRS="${ALLOWED_CIDRS:-}"
LISTENER_PORT="${LISTENER_PORT:-8000}"             # NLB 对外监听端口

# ---- GPU 实例 ----
INSTANCE_FAMILIES="${INSTANCE_FAMILIES:-g6}"       # 列出的 GPU 家族，空格分隔，例如 "g6 g6e g7e"
DEFAULT_INSTANCE_TYPE="${DEFAULT_INSTANCE_TYPE:-g6.12xlarge}"
# 主机型在所有 AZ 都没有容量时按顺序尝试的备选机型 (空格分隔)，例如 "g6.24xlarge g6.48xlarge"
FALLBACK_INSTANCE_TYPES="${FALLBACK_INSTANCE_TYPES:-}"
CAPACITY_RETRY_ROUNDS="${CAPACITY_RETRY_ROUNDS:-3}"           # 所有 AZ 轮询一遍算一轮
CAPACITY_RETRY_INTERVAL_SEC="${CAPACITY_RETRY_INTERVAL_SEC:-60}"
CAPACITY_RESERVATION_ID="${CAPACITY_RESERVATION_ID:-}"        # 可选: 已有 ODCR 的 ID (cr-xxxx)
ROOT_VOLUME_GB="${ROOT_VOLUME_GB:-200}"                       # 根卷 (gp3)，存放 Docker 镜像
# DLAMI 名称过滤 (describe-images 的 name 通配符)
AMI_NAME_FILTER="${AMI_NAME_FILTER:-Deep Learning*OSS Nvidia Driver*}"
AMI_ID="${AMI_ID:-}"                                          # 可选: 直接指定 AMI，跳过选择

# ---- 运维 SSH Key / 跳板机 (deploy-bastion.sh) ----
# SSH key pair 名称。为空时自动创建 "<PROJECT_NAME>-ops"，私钥保存到 SSH_KEY_DIR。
# 该 key 同时挂到跳板机和之后新建的 GPU 实例 (ssh -J 经跳板机登录 GPU 实例)
KEY_NAME="${KEY_NAME:-}"
SSH_KEY_DIR="${SSH_KEY_DIR:-$HOME/.ssh}"
# 允许 SSH 登录跳板机的来源 CIDR (逗号分隔，最多 5 个)。为空时提示输入 (重跑时沿用已部署的值)
SSH_ALLOWED_CIDRS="${SSH_ALLOWED_CIDRS:-}"
BASTION_INSTANCE_TYPE="${BASTION_INSTANCE_TYPE:-t3.small}"
BASTION_ROOT_VOLUME_GB="${BASTION_ROOT_VOLUME_GB:-50}"
# 跳板机除模型 bucket 外还需读写的 bucket (空格分隔)，例如 "customer-data-bucket customer-logs"
OPS_EXTRA_BUCKETS="${OPS_EXTRA_BUCKETS:-}"

# ---- 模型 ----
MODEL_ID="${MODEL_ID:-Qwen/Qwen3.5-35B-A3B-FP8}"   # Hugging Face model id
MODEL_REVISION="${MODEL_REVISION:-main}"
# 存放权重的 S3 bucket。为空则由 CloudFormation 自动创建 (删除栈时会保留)。
MODEL_BUCKET="${MODEL_BUCKET:-}"
MODEL_S3_PREFIX="${MODEL_S3_PREFIX:-models}"       # 权重路径: s3://<bucket>/<prefix>/<MODEL_ID>/<revision>/
# 可选: 存放 HF token 的 Secrets Manager secret ARN (gated 模型才需要，secret 值为纯文本 token)
HF_TOKEN_SECRET_ARN="${HF_TOKEN_SECRET_ARN:-}"

# ---- vLLM ----
VLLM_IMAGE="${VLLM_IMAGE:-vllm/vllm-openai:v0.31.0}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-65536}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.90}"
VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-auto}" # auto = 实例 GPU 数
# 额外参数，按模型调整。Qwen3.5 推荐开启 reasoning parser 与 tool call
VLLM_EXTRA_ARGS="${VLLM_EXTRA_ARGS:---reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder}"
